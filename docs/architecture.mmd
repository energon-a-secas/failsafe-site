        app --> render["render.js\nDashboard, editor, steps"]
        app --> events["events.js\nNavigation + handlers"]
        app --> protocols["protocols.js\nCRUD + 4 templates"]
        app --> cryptoMod["crypto.js\nAES-256-GCM"]
        app --> exportMod["export.js\nJSON + URL sharing"]
        app --> utils["utils.js\nHelpers"]
    end

    state <-->|"failsafe-v1"| Storage[("localStorage")]
    exportMod -->|"encrypt / decrypt"| cryptoMod
    exportMod -->|".failsafe.json"| Download["File download"]
    exportMod -->|"#p=..."| URLHash["URL hash"]
